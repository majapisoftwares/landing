# Resend SMTP credentials. Keep the real values in .env.local or your hosting provider.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=Majapi <contato@seu-dominio-verificado.com>

# Optional: where contact form submissions should arrive.
# If omitted, SMTP_FROM is used.
CONTACT_EMAIL=contato@seu-dominio-verificado.com
